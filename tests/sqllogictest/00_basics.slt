# Basic scalar expressions and typing.

query I
SELECT 1 + 1
----
2

query I
SELECT 7 * 6
----
42

query R
SELECT 10.0 / 4.0
----
2.5

query I
SELECT 10 / 4
----
2

query I
SELECT 2 + 3 * 4
----
14

query T
SELECT 'hello' || ' ' || 'world'
----
hello world

query I
SELECT length('hello')
----
5

query T
SELECT upper('abc'), lower('ABC')
----
ABC abc

query I rowsort
SELECT * FROM (VALUES (3), (1), (2)) AS t(x)
----
1
2
3

query I
SELECT CASE WHEN 1 < 2 THEN 10 ELSE 20 END
----
10

query I
SELECT NULL IS NULL, 1 IS NOT NULL
----
true true

query T
SELECT coalesce(NULL, 'fallback')
----
fallback

