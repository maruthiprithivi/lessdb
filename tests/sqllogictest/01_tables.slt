# Tables: DDL, INSERT, pruning-friendly scans, ordering.

statement ok
CREATE TABLE events (id Int64, kind String, amount Float64) ENGINE=Firefly ORDER BY (kind, id)

statement ok
INSERT INTO events VALUES (1, 'click', 1.5), (2, 'view', 2.5), (3, 'click', 3.5), (4, 'buy', 99.0)

query I
SELECT count(*) FROM events
----
4

query IT
SELECT id, kind FROM events ORDER BY id
----
1 click
2 view
3 click
4 buy

query TI rowsort
SELECT kind, id FROM events WHERE amount > 2
----
buy 4
click 3
view 2

query R
SELECT sum(amount) FROM events
----
106.5

query T
SELECT kind FROM events GROUP BY kind HAVING count(*) > 1 ORDER BY kind
----
click

query II
SELECT count(*), count(DISTINCT kind) FROM events
----
4 3

query I
SELECT id FROM events WHERE kind = 'click' AND amount BETWEEN 1 AND 4 ORDER BY id
----
1
3

statement ok
DROP TABLE events

query I
SELECT count(*) FROM (VALUES (1), (2)) AS t(x) WHERE x > 1
----
1
